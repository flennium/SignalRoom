  },
  "dependencies": {
    "@signalroom/protocol": "*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6"
  }
}
